// Production: PostgreSQL. Local dev: run `npm run db:sqlite` to generate a SQLite copy (prisma/dev/schema.prisma).
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String      @default("customer")
  locale        String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  messages      Message[]
  chats         ChatConversation[]
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  purpose    String   @default("verify") // verify | reset
  @@unique([identifier, token])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  email           String
  kind            String
  item            String      // catalog id, e.g. product:agency-ui-kit or gig:saas:basic
  title           String
  amount          Int         // cents
  currency        String      @default("usd")
  status          String @default("pending")
  stripeSessionId String?     @unique
  stripePaymentId String?
  dueAt           DateTime?
  requirements    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  events          OrderEvent[]
  files           OrderFile[]
  messages        Message[]
  @@index([userId])
}
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
model OrderFile {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  path      String
  kind      String   @default("delivery") // delivery | download | attachment
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
model Message {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  fromStaff Boolean  @default(false)
  body      String  
  file      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}
model Download {
  id        String   @id @default(cuid())
  sku       String   @unique // product slug
  path      String   // file path under DOWNLOADS_DIR
  name      String
}

// ---- SEO management ----
model SeoRecord {
  id           String   @id @default(cuid())
  path         String   // route without locale, e.g. /services/saas
  locale       String
  title        String?
  description  String?
  focusKw      String?
  secondaryKws String?
  canonical    String?
  robotsIndex  Boolean  @default(true)
  robotsFollow Boolean  @default(true)
  ogTitle      String?
  ogDesc       String?
  ogImage      String?
  jsonLdType   String?
  jsonLd       String?
  crumbLabel   String?
  hreflang     String?
  imageAlts    String?
  score        Int?
  updatedAt    DateTime @updatedAt
  @@unique([path, locale])
}
model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  code      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}
model Setting {
  key   String @id
  value String
}

// ---- Live chat ----
model ChatConversation {
  id        String        @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  locale    String        @default("en")
  status    String        @default("open") // open | human | closed
  page      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  sender         String           // visitor | ai | agent | system
  body           String          
  file           String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

// ---- Blog (DB posts override/extend the code-defined seed posts) ----
model BlogPost {
  id          String    @id @default(cuid())
  slug        String
  locale      String    @default("en")
  title       String
  description String
  category    String
  service     String?
  keyword     String?
  body        String   
  faq         String?
  image       String?
  status      String    @default("draft") // draft | scheduled | published
  publishAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([slug, locale])
}
