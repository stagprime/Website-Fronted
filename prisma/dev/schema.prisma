// Production: PostgreSQL. Local dev: run `npm run db:sqlite` to generate a SQLite copy (prisma/dev/schema.prisma).
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String      @default("customer")
  locale        String    @default("en")
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  disabled      Boolean   @default(false)
  notes         String?  
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  messages      Message[]
  chats         ChatConversation[]
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  purpose    String   @default("verify") // verify | reset
  @@unique([identifier, token])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  email           String
  kind            String
  item            String      // catalog id, e.g. product:agency-ui-kit or gig:saas:basic
  title           String
  amount          Int         // cents
  currency        String      @default("usd")
  status          String @default("pending")
  stripeSessionId String?     @unique
  stripePaymentId String?
  dueAt           DateTime?
  requirements    String?
  progress        Int         @default(0)
  assigneeId      String?
  deliveredAt     DateTime?
  refundedAmount  Int         @default(0)
  locale          String      @default("en")
  couponCode      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id])
  events          OrderEvent[]
  files           OrderFile[]
  messages        Message[]
  @@index([userId])
}
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    String
  note      String?
  kind      String      @default("status") // status | note | milestone | delivery | refund | system
  internal  Boolean     @default(false)
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
model OrderFile {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  path      String
  kind      String   @default("delivery") // delivery | download | attachment
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
model Message {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  fromStaff Boolean  @default(false)
  body      String  
  file      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}
model Download {
  id        String   @id @default(cuid())
  sku       String   @unique // product slug
  path      String   // file path under DOWNLOADS_DIR
  name      String
}

// ---- SEO management ----
model SeoRecord {
  id           String   @id @default(cuid())
  path         String   // route without locale, e.g. /services/saas
  locale       String
  title        String?
  description  String?
  focusKw      String?
  secondaryKws String?
  canonical    String?
  robotsIndex  Boolean  @default(true)
  robotsFollow Boolean  @default(true)
  ogTitle      String?
  ogDesc       String?
  ogImage      String?
  jsonLdType   String?
  jsonLd       String?
  crumbLabel   String?
  hreflang     String?
  imageAlts    String?
  score        Int?
  updatedAt    DateTime @updatedAt
  @@unique([path, locale])
}
model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  code      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}
model Setting {
  key   String @id
  value String
}

// ---- Live chat ----
model ChatConversation {
  id        String        @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  locale    String        @default("en")
  status    String        @default("open") // open | human | closed
  page      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  sender         String           // visitor | ai | agent | system
  body           String          
  file           String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

// ---- Blog (DB posts override/extend the code-defined seed posts) ----
model BlogPost {
  id          String    @id @default(cuid())
  slug        String
  locale      String    @default("en")
  title       String
  description String
  category    String
  service     String?
  keyword     String?
  body        String   
  faq         String?
  image       String?
  status      String    @default("draft") // draft | scheduled | published
  publishAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([slug, locale])
}

// ======================= CMS / admin (JSON payloads stored as text for Postgres + SQLite portability) =======================
model Page {
  id        String   @id @default(cuid())
  key       String   @unique            // home | /about | /privacy | custom slug (route without locale)
  title     String
  kind      String   @default("page")   // page | legal | custom
  status    String   @default("published") // draft | published
  sections  String             // JSON: Section[] (see lib/cms/blocks.ts)
  draft     String?            // JSON: unpublished Section[] for preview
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model UiString {
  key       String
  locale    String
  value     String  
  status    String   @default("reviewed") // reviewed | ai_draft
  updatedAt DateTime @updatedAt
  @@id([key, locale])
}
model Media {
  id        String   @id @default(cuid())
  path      String   @unique            // storage key, served at /media/<path>
  name      String
  mime      String
  size      Int
  width     Int?
  height    Int?
  alt       String?            // JSON {locale: alt}
  folder    String   @default("/")
  private   Boolean  @default(false)
  uploadedBy String?
  createdAt DateTime @default(now())
}
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  kind           String    @default("percent") // percent | fixed
  value          Int                           // percent 1-100 or cents
  appliesTo      String    @default("*")       // * or comma list of catalog ids / prefixes (gig:, product:)
  maxRedemptions Int?
  redeemed       Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  stripeCouponId String?
  createdAt      DateTime  @default(now())
}
model Form {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  fields    String             // JSON FormField[]
  settings  String             // JSON {recipients, successMsg{locale}, submitLabel{locale}}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submissions FormSubmission[]
}
model FormSubmission {
  id        String   @id @default(cuid())
  formId    String?
  formKey   String
  data      String  
  locale    String   @default("en")
  status    String   @default("new") // new | read | archived
  ip        String?
  createdAt DateTime @default(now())
  form      Form?    @relation(fields: [formId], references: [id], onDelete: SetNull)
  @@index([formKey, createdAt])
}
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String
  locale    String   @default("en")
  subject   String
  body      String  
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@unique([key, locale])
}
model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  locale    String   @default("en")
  body      String  
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
model NotFoundLog {
  path     String   @id
  hits     Int      @default(1)
  referrer String?
  lastSeen DateTime @updatedAt
}
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     String?
  action    String
  entity    String
  entityId  String?
  diff      String? 
  ip        String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}
model Revision {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  data      String  
  actor     String?
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
}
model Backup {
  id        String   @id @default(cuid())
  file      String
  size      Int
  kind      String   @default("content")
  actor     String?
  createdAt DateTime @default(now())
}
