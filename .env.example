# ───────── Stag Prime website — environment variables ─────────
# Copy to .env on the server (never commit .env). Empty = feature disabled gracefully.

# Core
NEXT_PUBLIC_SITE_URL=https://www.stagprime.com
PORT=3000
INTERNAL_URL=http://127.0.0.1:3000          # used by /admin/seo analyzer to fetch pages
DATABASE_URL=postgresql://stagprime:CHANGE_ME@127.0.0.1:5432/stagprime
AUTH_SECRET=                                # openssl rand -base64 32  (required for login)
AUTH_GOOGLE_ID=                             # Google OAuth (optional)
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=                                # used once by `npm run db:seed` to create the admin
ADMIN_PASSWORD=                             # 12+ chars; remove from .env after seeding

# Stripe
STRIPE_SECRET_KEY=                          # sk_live_...
STRIPE_WEBHOOK_SECRET=                      # whsec_... (endpoint /api/stripe/webhook)
STRIPE_PRICE_STAG_SENTINEL=                 # price_... for subscription "sub:stag-sentinel" (optional)

# Mail (Resend OR SMTP; neither = saved to data/outbox.jsonl + data/submissions.jsonl)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stag Prime <no-reply@stagprime.com>"
MAIL_TO=brand@stagprime.com

# Storage
SUBMISSIONS_DIR=                            # default ./data
UPLOADS_DIR=                                # default ./data/orders (order + chat uploads)
DOWNLOADS_DIR=                              # default ./data/downloads (digital products)

# Live chat AI first-responder (any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=                            # default https://api.openai.com/v1
OPENAI_MODEL=                               # default gpt-4o-mini

# Blog publishing API + IndexNow
BLOG_API_TOKEN=                             # openssl rand -hex 32
INDEXNOW_KEY=                               # also create public/<key>.txt containing the key

# Tracking (loaded only after cookie consent)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
NEXT_PUBLIC_GOOGLE_ADS_ID=                  # AW-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PURCHASE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_SIGNUP=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Search engine verification (meta tags)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
PINTEREST_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=
NAVER_VERIFICATION=
BAIDU_VERIFICATION=

# Crawlers
AI_CRAWLERS=                                # "block" disallows GPTBot/ClaudeBot/PerplexityBot/Google-Extended

# Local dev only
SP_SQLITE=                                  # 1 = use SQLite dev DB (npm run db:sqlite)
SP_I18N_COLLECT=                            # 1 = log untranslated strings to data/i18n-missing.txt
